# Sanity CMS Configuration
# Get these values from your Sanity project dashboard at https://sanity.io/manage
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# Server-side API token for authenticated operations
# Create at: Project Settings → API → Add Token
# Permissions: Read (for queries) or Write (for mutations)
SANITY_API_TOKEN=your_api_token_here
